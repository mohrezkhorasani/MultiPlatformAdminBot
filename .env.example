# ==============================================================================
# Hekmat Admin Bot - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual production/staging credentials.
# NOTE: Never commit your actual .env file to git!
# ==============================================================================

# Database Connection String
ConnectionStrings__DefaultConnection="Data Source=YOUR_DB_HOST;Initial Catalog=AdminBotDB;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True"
DEFAULT_CONNECTION="Data Source=YOUR_DB_HOST;Initial Catalog=AdminBotDB;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True"

# JWT Signing Key (Minimum 32 characters for security)
Jwt__SigningKey="REPLACE_WITH_YOUR_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS"
JWT_SECRET="REPLACE_WITH_YOUR_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS"

# Swagger UI Basic Authentication
Security__SwaggerUser="admin"
Security__SwaggerPassword="REPLACE_WITH_STRONG_SWAGGER_PASSWORD"
SWAGGER_USER="admin"
SWAGGER_PASSWORD="REPLACE_WITH_STRONG_SWAGGER_PASSWORD"

# Telegram PHP Proxy (for outbound Telegram API calls)
TelegramProxy__ProxyBaseUrl="https://your-proxy-domain.com/proxy/index.php"
TelegramProxy__Secret="REPLACE_WITH_PROXY_SHARED_SECRET"
TELEGRAM_PROXY_SECRET="REPLACE_WITH_PROXY_SHARED_SECRET"

# Admin & Notification Settings
Notify__ErrorChatId="YOUR_TELEGRAM_ADMIN_CHAT_ID"
Cors__AllowedOrigins="http://localhost:5173;http://localhost:3000"

# Optional Token Seeding (for initial deployment)
Seeder__SeedDefaults="false"
Seeder__TelegramToken=""
Seeder__BaleToken=""
Seeder__EitaaToken=""
Seeder__RubikaToken=""
